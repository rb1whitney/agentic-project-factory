# =============================================================================
# 5. AGENTIC FRAMEWORK (Swarm, MCP, Automation)
# =============================================================================

# --- Model Context Protocol (MCP) ---
# Allow MCP orchestration directory to be versioned
!mcp-servers/
!/mcp-servers/
# Ignore cloned MCP server repositories within it
mcp-servers/mcp-*/
# Ignore other misplaced mcp folders
/mcp-*/

# --- Swarm Automation: Brain, Cache & State ---
# Ignore automated discovery artifacts and temporary brain state.
.gemini/
.claude/
.cursor/
.agents/
.antigravitycli/
.antigravity/
.opencode/

# --- AST Cache & Generated Graphs ---
.ast_cache/
code_map.md
relationship_graph.json
symbol_map.json

# --- Swarm Automation: Always-On Memory Database ---
/memory.db
/memory.db-journal
/memory_v2.db

