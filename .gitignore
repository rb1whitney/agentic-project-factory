# =============================================================================
# Terraform
# =============================================================================

# Local .terraform directories and plugins
**/.terraform/*
**/.terraform.lock.hcl

# State files — NEVER commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan output files — contain sensitive data
*.tfplan
*.tfplan.json

# Crash log files
crash.log
crash.*.log

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variables files that may contain secrets
*.tfvars
*.tfvars.json

# Allow example/template var files to be committed
!*.tfvars.example
!*.tfvars.json.example

# =============================================================================
# Packer
# =============================================================================

# Packer cache
packer_cache/

# Packer build artifacts
*.box

# =============================================================================
# Ansible
# =============================================================================

# Retry files
*.retry

# Vault password files
.vault_pass
.vault_password
vault_pass.txt

# Ansible temporary files
.ansible/

# Role downloaded via galaxy (should be fetched at runtime)
roles/galaxy/

# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
.env
ENV/

# pip
pip-log.txt
pip-delete-this-directory.txt

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checkers
.mypy_cache/
.dmypy.json
.pytype/

# =============================================================================
# Node.js
# =============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
dist/
.next/
out/

# Lock files (keep package-lock.json / yarn.lock, but ignore others)
.pnp
.pnp.js

