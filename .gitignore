*-service-account.json
*-sa-key.json
service_account*.json
credentials.json
gcloud-credentials.json
application_default_credentials.json

# Generic secret files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.der
secrets.yml
secrets.yaml
.secrets
secrets/
.env.local
.env.production
.env.*.local

