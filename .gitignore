.github/artifacts/
junit-*.xml
test-report*.xml

# =============================================================================
# Model Context Protocol (MCP)
# =============================================================================

# Unignore the orchestration directory to allow scripts
!mcp-servers/

# Ignore cloned MCP server repositories (automated via download_mcps.sh)
mcp-servers/mcp-*/

# Safety: Ignore other misplaced mcp folders in root
/mcp-*/
!/mcp-servers/
bin/kubectl

# --- Swarm Security: Zero-Trust Credentials ---
# Local secret files are STRICTLY FORBIDDEN.
# Use ~/.mcp-servers/credentials (outside repo) instead.
*.env
.env.*
credentials

# --- Swarm Automation: Brain & Cache ---
# Ignore automated discovery artifacts and temporary brain state
.gemini/antigravity/
.ast_cache/
relationship_graph.json
code_map.md

projects/
# IDE Specific Rules (Polyfills)
.cursor/rules/*
.claude/agents/*
.gemini/agents/*
.github/agents/*
.github/skills/*
.vscode/agents/*

# --- Swarm Automation: Always-On Memory Database ---
/memory.db
/memory.db-journal
