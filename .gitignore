# =============================================================================
# 4. SECURITY & SECRETS (Zero-Trust)
# =============================================================================
# Local secret files are STRICTLY FORBIDDEN.
# Use ~/.mcp-servers/credentials (outside repo) instead.

# --- Environment Variables ---
.env
.env.*
*.env

# --- Cloud Credentials ---
.aws/credentials
aws-credentials.json
