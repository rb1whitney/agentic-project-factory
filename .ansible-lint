---
# ansible-lint configuration
# Profile: production (strictest — enforces all best practice rules)
profile: production

# Exclude paths from linting
exclude_paths:
  - .github/
  - .git/
  - node_modules/
  - .venv/
  - "*.md"

# Enable specific optional rules beyond the profile
enable_list:
  - no-changed-when          # Tasks that change state must have changed_when
  - no-free-form             # Disallow free-form module arguments
  - partial-become           # Catch incomplete become configurations
  - yaml[truthy]             # Enforce true/false instead of yes/no

# Warn-only rules (will not fail the run)
warn_list:
  - experimental             # Experimental rules produce warnings only
  - role-name                # Role naming convention

# Rules to skip entirely (add per-project exceptions here)
skip_list: []

# Enforce consistent YAML formatting
yaml_options:
  width: 120
  indent: 2

# Require name on all tasks and plays
use_default_rules: true

# Offline mode — do not try to resolve Galaxy requirements
offline: false

# Verbosity level: 0=quiet, 1=normal, 2=verbose
verbosity: 1
