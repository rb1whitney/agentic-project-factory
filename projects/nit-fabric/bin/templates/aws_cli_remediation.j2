    --group-id {{ rule.group_id }} \
    --security-group-rule-ids {{ rule.rule_id }}

{% elif id == 'PRIVATE_ACCESS_AUDIT' %}
# Expert Note: Enabling Private DNS for Interface Endpoint to ensure internet excision.
