{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent.schema.json",
  "title": "Canonical agent definition (.agent/agents/<name>.yaml)",
  "description": "Harness-neutral. Capabilities not tool names; harness mapping lives in .agent/adapters/map.yaml. File stem must equal name.",
  "type": "object",
  "required": ["version", "name", "description", "tier", "capabilities", "prompt"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string"},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1},
    "role": {"enum": ["worker", "orchestrator"]},
    "tier": {"enum": ["fast", "deep"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["read", "search", "write", "shell", "web", "delegate"]}
    },
    "skills": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "returns": {"type": "string"},
    "prompt": {"type": "string", "minLength": 1}
  }
}
