{
  "theme": "dark",
  "verbosity": "low",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 bin/autoload_webhook.py"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|run_shell_command|Write|replace",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agent/hooks/enforce-safety.sh \"$CLAUDE_TOOL_NAME\" \"$CLAUDE_TOOL_INPUT\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|replace",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agent/hooks/audit_stubs.sh"
          }
        ]
      }
    ]
  }
}
