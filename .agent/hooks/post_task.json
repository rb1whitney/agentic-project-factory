{
  "event": "postTask",
  "actions": [
    {
      "type": "command",
      "execute": "python3 bin/update_docs.py",
      "description": "Auto-update documentation based on task outcome."
    },
    {
      "type": "notification",
      "channel": "system",
      "message": "Task complete. Documentation updated successfully."
    }
  ]
}
