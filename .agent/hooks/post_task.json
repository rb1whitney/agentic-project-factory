{
  "event": "postTask",
  "actions": [
    {
      "type": "command",
      "execute": "python3 bin/update_docs.py",
      "description": "Auto-update documentation based on task outcome."
    },
    {
      "type": "command",
      "execute": "python3 bin/memory_agent.py complete default_session",
      "description": "Mark Always-On Memory database session COMPLETED."
    },
    {
      "type": "command",
      "execute": "bash bin/logger.sh",
      "description": "Log prompt and response to stack files."
    },
    {
      "type": "command",
      "execute": "python3 bin/track-savings.py",
      "description": "Track token savings and usage."
    },
    {
      "type": "notification",
      "channel": "system",
      "message": "Task complete. Documentation updated successfully."
    }
  ]
}
