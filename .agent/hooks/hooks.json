{
  "factory-autoload-webhook": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 bin/autoload_webhook.py",
        "timeout": 15
      }
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_command|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.agent/skills/skill-code-map/scripts/noise_gate.py || echo '{\"decision\":\"allow\"}'",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
