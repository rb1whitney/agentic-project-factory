[
  {"apiVersion": "apps/v1", "kind": "Deployment",
   "metadata": {"name": "payments-api", "namespace": "payments"},
   "spec": {"replicas": 2,
            "selector": {"matchLabels": {"app": "payments-api"}},
            "template": {"metadata": {"labels": {"app": "payments-api"}},
                         "spec": {"containers": [{"name": "api",
                                                  "image": "registry.example.com/payments-api:1.3.9",
                                                  "ports": [{"containerPort": 8080}]}]}}}},
  {"apiVersion": "v1", "kind": "Service",
   "metadata": {"name": "payments-api", "namespace": "payments"},
   "spec": {"selector": {"app": "payments-api"}, "ports": [{"port": 80, "targetPort": 8080}]}},
  {"apiVersion": "apps/v1", "kind": "Deployment",
   "metadata": {"name": "legacy-worker", "namespace": "payments"},
   "spec": {"replicas": 1}}
]
